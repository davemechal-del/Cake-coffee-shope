# PORT: Render automatically injects PORT at runtime (defaults to 3000 locally).
PORT="3000"

# ADMIN_EMAIL & ADMIN_PASSWORD: Credentials for /admin.html login.
# Set strong values in Render > Environment Variables before deploying.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# SESSION_SECRET: Random secret used to sign admin session tokens.
SESSION_SECRET="change-me-random-secret"

# DATA_DIR: Optional persistent directory for products.json (e.g. Render Persistent Disk mount path like /var/data).
DATA_DIR=""
