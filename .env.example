# PORT: Render automatically injects PORT at runtime (defaults to 3000 locally).
PORT="3000"

# DATABASE_URL: Render PostgreSQL connection string.
# Leave empty locally to use the built-in SQLite database (data/shop.db).
DATABASE_URL=""

# ADMIN_EMAIL & ADMIN_PASSWORD: Credentials seeded into the admins table for /admin.html login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# SESSION_SECRET: Random secret used to sign admin session tokens.
SESSION_SECRET="change-me-random-secret"

# DATA_DIR: Optional directory for local SQLite file (data/shop.db).
DATA_DIR=""
